# FilingBridge connector, HTTP mode (filingbridge-mcp serve --http).
# Runs inside the stack as the `mcp` service, reached only through the
# frontend's /mcp route on the internal frontend_api network.

FROM node:24-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf AS deps
WORKDIR /app
COPY mcp/package.json mcp/package-lock.json ./
# Runtime dependencies only. The OS keychain binding (@napi-rs/keyring) is
# installed but never loaded: HTTP mode holds no credential of its own.
RUN npm ci --omit=dev --ignore-scripts

FROM node:24-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf AS builder
WORKDIR /app
COPY mcp/package.json mcp/package-lock.json ./
RUN npm ci --ignore-scripts
COPY mcp/tsconfig.json ./
COPY mcp/src ./src
RUN npx tsc -p tsconfig.json && rm -rf dist/tests

FROM node:24-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache --upgrade "libcrypto3>=3.5.8-r0" "libssl3>=3.5.8-r0"
RUN rm -rf \
    /usr/local/lib/node_modules/npm \
    /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm \
    /usr/local/bin/npx \
    /usr/local/bin/corepack \
    /usr/local/bin/yarn \
    /usr/local/bin/yarnpkg \
    /usr/local/bin/pnpm \
    /usr/local/bin/pnpx \
    /opt/yarn-v*
RUN addgroup --system --gid 1002 filingbridge && adduser --system --uid 1002 --ingroup filingbridge filingbridge
COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY mcp/package.json ./package.json
USER 1002:1002
EXPOSE 3100
# The compose healthcheck runs: wget -qO- http://127.0.0.1:3100/healthz
CMD ["node", "dist/cli.js", "serve", "--http", "--host", "0.0.0.0", "--port", "3100"]
