FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:72dd743782f2ae7e5476fd64f6a460045e3998dc862218b80e6944cba79a01b0 AS build
WORKDIR /src
COPY backend/Accounts.Api/Accounts.Api.csproj backend/Accounts.Api/packages.lock.json ./backend/Accounts.Api/
RUN dotnet restore backend/Accounts.Api/Accounts.Api.csproj --locked-mode
COPY backend/ ./backend/
RUN dotnet publish backend/Accounts.Api/Accounts.Api.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:f1126d438ccc359f51cc6d4701a8deae513856cf10f5fe645d29ea6403dcac6b AS runtime
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/publish .
EXPOSE 8080
USER $APP_UID
ENTRYPOINT ["dotnet", "Accounts.Api.dll"]
