FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:0d99ebf1ccad15037b5c98c9fe8979d6b8dbac23812feae2277a0b277b5c5ffa AS build
WORKDIR /src
COPY backend/Accounts.Api/Accounts.Api.csproj backend/Accounts.Api/packages.lock.json ./backend/Accounts.Api/
RUN dotnet restore backend/Accounts.Api/Accounts.Api.csproj --locked-mode
COPY backend/ ./backend/
RUN dotnet publish backend/Accounts.Api/Accounts.Api.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:d5633778c754e89a386882eddf8dbee6942447a8a4b8267c19cf1e1158d0b0ac AS runtime
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/publish .
EXPOSE 8080
USER $APP_UID
ENTRYPOINT ["dotnet", "Accounts.Api.dll"]
